# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Required: Anthropic API key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Model for the classifier / question agent
TOT_MODEL=claude-sonnet-5-5

# Server-side deadline for one classify call. Keep below the extension's 10 s cover budget.
TOT_CLASSIFY_TIMEOUT_MS=9800

# Server-side deadline for one follow-up judgment (prompt 2). Keep below the extension's 4 s budget.
TOT_FOLLOW_UP_TIMEOUT_MS=3800

# Server-side deadline for composing the message pasted into Claude (prompt 3). Keep below the extension's 5 s budget.
TOT_COMPOSE_TIMEOUT_MS=4800

# Local API port
PORT=8787

# Comma-separated origins allowed via CORS, e.g. chrome-extension://<your-extension-id>
TOT_ALLOWED_ORIGINS=

# Optional: override the system prompt files (defaults in api/prompts/)
TOT_CLASSIFY_PROMPT_PATH=
TOT_FOLLOW_UP_PROMPT_PATH=
TOT_COMPOSE_PROMPT_PATH=
